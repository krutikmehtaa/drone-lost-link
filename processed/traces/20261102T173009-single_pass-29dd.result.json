    "status": "drafted",
    "abstain_reason": null,
    "claims": [
     {
      "text": "EVO Max 4N Signal Lost behavior options include Return to Home, Hover, and Land; Signal Lost Action options include Continue mission and Auto RTH; reconnection within 10 seconds returns control to the remote controller.",
      "citations": [
