 "mode": "single_pass",
 "question": "What does current FAA guidance say should happen when a small drone loses its control link?",
 "status": "completed_with_gaps",
 "stop_reason": "verified claims; gaps listed",
 "error": null,
 "intake": {
  "intent": "in_scope",
  "models": [
   "DJI Matrice 30T",
