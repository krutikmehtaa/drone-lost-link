  "short_answer": "FAA guidance does not mandate a single failsafe mode for lost links; it requires pre-determined procedures and allows options such as RTH, hover, or land based on the situation and aircraft capabilities.",
  "sections": [
   {
    "section": "faa",
    "label": "FAA guidance",
    "status": "drafted",
    "abstain_reason": null,
    "claims": [
     {
      "text": "FAA guidance requires pre-determined procedures for loss of control link.",
      "citations": [
       "faa_ac_107_2a_2022_c0049"
      ],
      "quote": "If the remote PIC cannot regain VLOS, the remote PIC or person manipulating the controls should follow pre-determined procedures for the loss of VLOS.",
      "conditions": [
       "None"
      ],
      "assessment": "supported",
      "claim_id": "C001",
      "section": "faa",
      "tier": "official",
      "incident_label": null
     },
     {
      "text": "FAA guidance notes that guidance includes examples like reestablishing control link and, if not possible, emergency or contingency procedures.",
      "citations": [
       "faa_ac_107_2a_2022_c0228"
      ],
      "quote": "Example: Try to reestablish control link connection with the small unmanned aircraft. If connection cannot be reestablished, start emergency or contingency procedures for loss of control link.",
      "conditions": [
       "None"
      ],
      "assessment": "supported",
      "claim_id": "C002",
      "section": "faa",
